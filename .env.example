# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The site's public address, for redirects. Required in production (e.g. on
# Render: https://yourway.onrender.com); leave unset for local dev.
SITE_URL=

# Contact form (Resend → https://resend.com/api-keys). Server-only.
# CONTACT_FROM_EMAIL needs a domain verified in Resend; leave it unset to use
# Resend's test sender, which only delivers to your Resend account's address.
# Use a no-reply address on that domain, e.g. noreply@yourdomain.co.il.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Where contact messages arrive; defaults to SUPPORT_EMAIL in lib/support.ts.
CONTACT_TO_EMAIL=

# Sign-in with a personal code (admin page → כניסה עם קוד אישי). The Supabase
# secret key, server-only: it creates the approved users and opens their sessions.
SUPABASE_SECRET_KEY=

# The drivers' daily email runs in a Supabase Edge Function, whose secrets are
# set with `supabase secrets set`, not here. See README → Daily passenger email.
# These are only for npm run test:email and npm run test:email:e2e.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TEST_TO=
